# ---------------------------------------------------------------------------
# 1. SINALIZACAO  (obrigatorio em producao)
# ---------------------------------------------------------------------------
# A Vercel executa cada requisicao numa instancia possivelmente diferente, e
# duas instancias nao compartilham memoria. Sem um armazenamento externo, o
# anfitriao e o visualizante caem em lambdas distintos e nunca trocam SDP.
#
# Crie um banco Redis no marketplace da Vercel (Upstash) ou em upstash.com.
# A integracao da Vercel injeta essas variaveis sozinha; localmente, copie-as.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Aceitamos tambem os nomes antigos do Vercel KV:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---------------------------------------------------------------------------
# 2. TURN  (fortemente recomendado)
# ---------------------------------------------------------------------------
# STUN resolve a maioria das redes domesticas. TURN e o que salva os 10-20%
# restantes: NAT simetrico, wifi de hotel, rede corporativa com firewall.
# Configure UM dos blocos abaixo.

# -- Cloudflare Realtime TURN (1 TB/mes gratuito) --
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# -- Metered.ca --
# METERED_API_KEY=
# METERED_SUBDOMAIN=

# -- Twilio Network Traversal --
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# -- coturn proprio, modo `use-auth-secret` (credencial temporaria) --
# TURN_URLS=turn:turn.exemplo.com:3478,turns:turn.exemplo.com:5349
# TURN_SECRET=o-mesmo-static-auth-secret-do-turnserver.conf

# -- coturn proprio, usuario fixo --
# TURN_URLS=turn:turn.exemplo.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# ---------------------------------------------------------------------------
# 3. STUN  (opcional — ha um padrao embutido)
# ---------------------------------------------------------------------------
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
